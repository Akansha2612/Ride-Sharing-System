
# ==========================================
# API Gateway Configuration
# ==========================================

spring.application.name=api-gateway

# Gateway Port
server.port=8080


# ==========================================
# 1. Passenger Microservice - Port 8081
# ==========================================

spring.cloud.gateway.server.webflux.routes[0].id=passenger-service
spring.cloud.gateway.server.webflux.routes[0].uri=http://localhost:8081
spring.cloud.gateway.server.webflux.routes[0].predicates[0]=Path=/api/v1/passengers,/api/v1/passengers/**


# ==========================================
# 2. Driver Microservice - Port 8082
# ==========================================

spring.cloud.gateway.server.webflux.routes[1].id=driver-service
spring.cloud.gateway.server.webflux.routes[1].uri=http://localhost:8082
spring.cloud.gateway.server.webflux.routes[1].predicates[0]=Path=/api/v1/drivers,/api/v1/drivers/**


# ==========================================
# 3. Ride Microservice - Port 8083
# ==========================================

spring.cloud.gateway.server.webflux.routes[2].id=ride-service
spring.cloud.gateway.server.webflux.routes[2].uri=http://localhost:8083
spring.cloud.gateway.server.webflux.routes[2].predicates[0]=Path=/api/v1/rides,/api/v1/rides/**


# ==========================================
# Spring Boot Actuator
# ==========================================

management.endpoints.web.exposure.include=health,info
